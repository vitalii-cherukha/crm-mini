# Секрети Edge Function analyze-note. НІКОЛИ не потрапляють на фронтенд.
# Локально: покласти у supabase/functions/analyze-note/.env і запускати
#   supabase functions serve analyze-note --env-file supabase/functions/analyze-note/.env
# Прод: supabase secrets set OPENAI_API_KEY=sk-...

OPENAI_API_KEY=sk-your-openai-api-key
# Опційно, за замовчуванням "gpt-4o-mini"
OPENAI_MODEL=gpt-4o-mini

# Дані нижче потрібні лише якщо пишеш допоміжні скрипти/сиди на боці бекенду
# (наприклад, локальні seed-скрипти). Фронтенд використовує лише anon key
# зі свого власного .env (див. crm-mini/.env.example).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
